{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RISC-V 工具箱",
  "version": "0.1.0",
  "identifier": "com.riscv.toolbox",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "RISC-V 工具箱",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src https://luplab.gitlab.io"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
